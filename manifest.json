{
  "manifest_version": 3,
  "name": "Meet Record Reminder",
  "version": "1.0.0",
  "description": "Shows a big, hard-to-miss reminder to start notes or recording when you join a Google Meet call.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
